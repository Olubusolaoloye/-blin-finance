# ── Indexer ─────────────────────────────────────────────────────────────────
ALCHEMY_API_KEY=your_alchemy_api_key_here
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here
MORALIS_API_KEY=your_moralis_api_key_here

# ── WalletConnect ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ── Default chain (wagmi chain id) ───────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_CHAIN=56

# ── Contract deployment ───────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x_your_deployer_private_key_here
DEPLOYER_ADDRESS=0x_your_deployer_address_here
TREASURY_ADDRESS=0x_your_treasury_address_here
MULTISIG_ADDRESS=0x_your_multisig_address_here
ASSET_ADDRESS=0x_usdc_or_usdt_address_for_target_chain
AAVE_POOL_ADDRESS=0x_aave_v3_pool_address_for_target_chain

# ── Block explorers ───────────────────────────────────────────────────────────
BSCSCAN_API_KEY=your_bscscan_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# ── RPC endpoints (used by Foundry scripts) ───────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
ETHEREUM_RPC_URL=https://eth.llamarpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
